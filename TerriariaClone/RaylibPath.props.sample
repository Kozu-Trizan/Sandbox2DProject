<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
	<!-- Set this to your local raylib installation path -->
	<RaylibPath>C:\Your\Raylib\Path\Here</RaylibPath>
	<RaylibIncludePath>$(RaylibPath)\include</RaylibIncludePath>
	<RaylibLibPath>$(RaylibPath)\lib</RaylibLibPath>
  </PropertyGroup>
</Project>
